PORT=3000
JWT_SECRET=change-this-to-a-long-random-secret-32-chars-min
JWT_EXPIRES_IN=7d
DATABASE_PATH=./data/marketing-os.db
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_TASK=http://localhost:5678/webhook/marketing-os-task
N8N_WEBHOOK_REPORT=http://localhost:5678/webhook/marketing-os-report
OS_API_KEY=local-dev-key-change-me
ANTIGRAVITY_WORKSPACE=./antigravity
CORS_ORIGIN=http://localhost:3000

# Local LLM (Ollama) & Vercel-to-Local Worker Bridge
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_MS=300000
OLLAMA_MAX_TOKENS=1024
MARKETING_OS_URL=http://127.0.0.1:3000
